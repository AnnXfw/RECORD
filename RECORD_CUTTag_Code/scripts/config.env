# Repository-relative CUT&Tag configuration
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RAW_ROOT="${RAW_ROOT:-${ROOT}/data/cuttag_bg4/rawdata}"
OUT_ROOT="${OUT_ROOT:-${ROOT}/results/cuttag_bg4}"
BT2_INDEX="${BT2_INDEX:-${ROOT}/data/cuttag_bg4/reference/bowtie2/hg19}"
BLACKLIST="${BLACKLIST:-${ROOT}/data/cuttag_bg4/reference/hg19-blacklist.v2.bed}"
BG4_BED="${BG4_BED:-${ROOT}/data/cuttag_bg4/reference/G4.bed}"
POTENTIAL_G4_BED="${POTENTIAL_G4_BED:-${ROOT}/data/cuttag_bg4/reference/Potential_G4.bed}"
SAMPLES_TSV="${SAMPLES_TSV:-${ROOT}/scripts/samples.tsv}"
PAIRS_TSV="${PAIRS_TSV:-${ROOT}/scripts/peak_pairs.tsv}"
CONDA_ENV="${CUTTAG_ENV:-cuttag}"
